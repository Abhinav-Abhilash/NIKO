# Application Environment
APP_ENV=development
APP_NAME=NIKO
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Database (Path relative to workspace root or absolute)
DATABASE_URL=sqlite+aiosqlite:///storage/niko.db

# Cryptographic Keys (Auto-generated on first setup if missing)
# Generate Fernet key via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key_base64_here
# Generate JWT secret via: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# First-boot Single-Owner One-Time Setup Token (Generated on first launch)
SETUP_TOKEN=your_one_time_setup_token_hex_here

# Security & Isolation
TRUSTED_HOSTS=["127.0.0.1", "localhost"]
CORS_ORIGINS=["http://127.0.0.1:5173", "http://localhost:5173"]
WS_ALLOWED_ORIGINS=["http://127.0.0.1:5173", "http://localhost:5173"]

# Storage & Logs
STORAGE_DIR=storage
LOG_LEVEL=INFO

# Optional Initial Provider API Keys (Encrypted into DB on initialization)
INITIAL_GEMINI_API_KEY=
INITIAL_GROQ_API_KEY=
INITIAL_OPENROUTER_API_KEY=
