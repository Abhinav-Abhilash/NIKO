{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Scoped permissions for overlay and dashboard windows enforcing least privilege",
  "windows": [
    "overlay",
    "dashboard"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible"
  ]
}
